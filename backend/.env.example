# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/security_audit_dashboard
# Atlas:      mongodb+srv://<username>:<password>@<cluster>.mongodb.net/security_audit_dashboard
MONGO_URI=your_mongo_connection_string_here

# CORS - comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173
git add .gitignore README.md backend/.env.example frontend/.env.example backend frontend